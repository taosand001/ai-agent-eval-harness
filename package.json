{
  "name": "ai-agent-eval-harness",
  "version": "1.0.0",
  "description": "Production-ready evaluation framework for AI browser automation agents",
  "type": "module",
  "scripts": {
    "eval": "tsx evals/runner.ts 5",
    "eval:10": "tsx evals/runner.ts 10",
    "eval:50": "tsx evals/runner.ts 50",
    "eval:baseline": "tsx evals/runner.ts 20 --update-baseline",
    "mock-server": "tsx mock-site.ts",
    "test": "npm run eval"
  },
  "keywords": ["ai-agent", "testing", "evaluation", "playwright", "browser-automation"],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ai-agent-eval-harness"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15"
  }
}
